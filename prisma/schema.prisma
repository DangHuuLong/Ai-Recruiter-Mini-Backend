generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  ADMIN
  RECRUITER
  HIRING_MANAGER
  // Manages the shared (non-org-scoped) InterviewQuestionEntry bank —
  // see Phase 7. Distinct from ADMIN because it's a cross-cutting content
  // role, not an organization-management role.
  DEV
}

enum FileAssetStatus {
  ACTIVE
  DELETED
}

enum ResumeFileType {
  PDF
  DOCX
}

enum ParseStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum ApplicationStatus {
  DRAFT
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEWING
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum EvaluationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CriterionName {
  SKILLS_MATCH
  EXPERIENCE_RELEVANCE
  PROJECT_RELEVANCE
  EDUCATION_CERTIFICATION
  KEYWORD_DOMAIN_ALIGNMENT
}

enum SkillMatchType {
  MATCHED
  MISSING
  RELATED
}

enum JobSkillType {
  REQUIRED
  PREFERRED
}

enum CandidateIdentityConfidence {
  HIGH
  MEDIUM
  LOW
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ScoringBatchStatus {
  PENDING
  PARSING
  SCORING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

// ─────────────────────────────────────────────
// ORGANIZATION (multi-tenant root)
// ─────────────────────────────────────────────

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  billingEmail String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users             User[]
  candidates        Candidate[]
  jobDescriptions   JobDescription[]
  applications      Application[]
  evaluations       Evaluation[]
  evaluationConfigs EvaluationConfig[]
  fileAssets        FileAsset[]
  scoringBatches    ScoringBatch[]

  @@index([slug])
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  organizationId  String
  email           String    @unique
  passwordHash    String
  fullName        String?
  role            UserRole  @default(RECRUITER)
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdJobs              JobDescription[]   @relation("JobDescriptionCreatedBy")
  createdApplications      Application[]      @relation("ApplicationCreatedBy")
  createdEvaluations       Evaluation[]       @relation("EvaluationCreatedBy")
  createdEvaluationConfigs EvaluationConfig[] @relation("EvaluationConfigCreatedBy")
  authTokens               AuthToken[]
  createdScoringBatches    ScoringBatch[]     @relation("ScoringBatchCreatedBy")

  @@index([organizationId])
}

// Verification/password-reset tokens. tokenHash stores a sha256 hash of the
// raw token — the raw value is only ever sent to the user via email, never persisted.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ─────────────────────────────────────────────
// FILE ASSET
// ─────────────────────────────────────────────

model FileAsset {
  id              String          @id @default(cuid())
  organizationId  String
  fileName        String
  originalFileUrl String
  storageKey      String          @unique
  fileType        ResumeFileType
  fileSizeBytes   Int
  checksum        String?
  bucket          String
  status          FileAssetStatus @default(ACTIVE)
  uploadedAt      DateTime        @default(now())
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization                Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resumes                     Resume[]
  scoringBatchResumes         ScoringBatchResume[]
  scoringBatchJobDescriptions ScoringBatchJobDescription[]

  @@index([organizationId])
  @@index([fileType])
  @@index([checksum])
  @@index([status])
  @@index([uploadedAt])
}

// ─────────────────────────────────────────────
// CANDIDATE & RESUME
// ─────────────────────────────────────────────

model Candidate {
  id                 String                      @id @default(cuid())
  organizationId     String
  fullName           String?
  primaryEmail       String?
  primaryPhone       String?
  linkedinUrl        String?
  portfolioUrl       String?
  githubUrl          String?
  location           String?
  latestHeadline     String?
  summary            String?
  identityConfidence CandidateIdentityConfidence @default(LOW)
  // Aggregated parsed profile across resumes — used for cross-resume reuse.
  // Updated each time a new resume is successfully parsed.
  normalizedProfile  Json?
  notes              String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resumes             Resume[]
  applications        Application[]
  scoringBatchResumes ScoringBatchResume[]

  @@index([organizationId])
  @@index([organizationId, primaryEmail])
  @@index([organizationId, primaryPhone])
  @@index([fullName])
}

model Resume {
  id          String @id @default(cuid())
  candidateId String
  // Nullable — a resume promoted from a text/structured ScoringBatchResume
  // (Phase 5) has no backing file at all.
  fileAssetId String?

  rawText       String?
  parsedData    Json?
  parseStatus   ParseStatus @default(PENDING)
  parserVersion String?
  parsingError  String?

  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  candidate    Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fileAsset    FileAsset?    @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)
  applications Application[]

  @@index([candidateId])
  @@index([fileAssetId])
  @@index([parseStatus])
}

// ─────────────────────────────────────────────
// JOB DESCRIPTION
// ─────────────────────────────────────────────

model JobDescription {
  id             String      @id @default(cuid())
  organizationId String
  createdById    String?
  title          String
  companyName    String?
  department     String?
  location       String?
  employmentType String?
  seniority      String?
  // Nullable — a JD promoted from a file/structured ScoringBatchJobDescription
  // (Phase 5) has no pasted raw text at all.
  rawText        String?
  // Structured JSON extracted from JD.
  // Shape: { responsibilities[], requirements[], niceToHave[], minExperienceYears, educationRequirement, domainKeywords[] }
  parsedData     Json?
  parserVersion  String?
  parseStatus    ParseStatus @default(PENDING)
  parsingError   String?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization      Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy         User?                        @relation("JobDescriptionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  applications      Application[]
  skills            JobSkill[]
  evaluationConfigs EvaluationConfig[]
  scoringBatchItems ScoringBatchJobDescription[]

  @@index([organizationId])
  @@index([createdById])
  @@index([title])
  @@index([companyName])
  @@index([parseStatus])
}

// Structured skills extracted from a JD.
// Source of truth for skill matching — preferred over parsing parsedData.Json at query time.
model JobSkill {
  id               String       @id @default(cuid())
  jobDescriptionId String
  name             String
  normalizedName   String?
  type             JobSkillType
  isCore           Boolean      @default(false)
  // Optional hint to scoring engine — overrides default criterion weight for this skill.
  weightHint       Float?
  createdAt        DateTime     @default(now())

  jobDescription JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)

  @@index([jobDescriptionId])
  @@index([name])
  @@index([normalizedName])
}

// ─────────────────────────────────────────────
// APPLICATION
// ─────────────────────────────────────────────

// Represents a candidate applying to a specific JD with a specific resume.
// resumeId is required and must belong to the candidate — enforced at application layer.
model Application {
  id               String            @id @default(cuid())
  organizationId   String
  candidateId      String
  jobDescriptionId String
  resumeId         String
  createdById      String?
  status           ApplicationStatus @default(APPLIED)
  source           String?
  appliedAt        DateTime          @default(now())
  lastActivityAt   DateTime?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate      Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobDescription JobDescription     @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  // onDelete: Restrict — do not allow deleting a resume that is tied to an application.
  resume         Resume             @relation(fields: [resumeId], references: [id], onDelete: Restrict)
  createdBy      User?              @relation("ApplicationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  evaluations    Evaluation[]
  events         ApplicationEvent[]

  @@index([organizationId])
  @@index([candidateId])
  @@index([jobDescriptionId])
  @@index([resumeId])
  @@index([createdById])
  @@index([status])
}

// Audit log for application lifecycle changes.
// eventType examples: "STATUS_CHANGED", "EVALUATION_COMPLETED", "NOTE_ADDED"
model ApplicationEvent {
  id            String   @id @default(cuid())
  applicationId String
  eventType     String
  // Arbitrary payload — shape depends on eventType.
  eventData     Json?
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([eventType])
}

// ─────────────────────────────────────────────
// EVALUATION CONFIG
// ─────────────────────────────────────────────

// Defines scoring criteria and weights for an evaluation run.
// Can be scoped to a specific JD or used as a global default.
//
// criteriaDefinition shape (Json):
// [
//   { "criterion": "SKILLS_MATCH",             "weight": 0.35 },
//   { "criterion": "EXPERIENCE_RELEVANCE",      "weight": 0.30 },
//   { "criterion": "PROJECT_RELEVANCE",         "weight": 0.15 },
//   { "criterion": "EDUCATION_CERTIFICATION",   "weight": 0.10 },
//   { "criterion": "KEYWORD_DOMAIN_ALIGNMENT",  "weight": 0.10 }
// ]
// totalWeight must equal 1.0. Enforced at application layer.
model EvaluationConfig {
  id                 String   @id @default(cuid())
  organizationId     String
  jobDescriptionId   String?
  createdById        String?
  name               String
  description        String?
  isDefault          Boolean  @default(false)
  criteriaDefinition Json
  // Must equal sum of all criterion weights. Stored for fast validation.
  totalWeight        Float
  version            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobDescription JobDescription? @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation("EvaluationConfigCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  evaluations    Evaluation[]
  scoringBatches ScoringBatch[]

  @@index([organizationId])
  @@index([jobDescriptionId])
  @@index([createdById])
  @@index([isDefault])
}

// ─────────────────────────────────────────────
// EVALUATION
// ─────────────────────────────────────────────

// One evaluation = one scoring run for one application using one config.
// resumeId is NOT stored here — derive it from application.resumeId when needed.
//
// overallScore range: 0.0–100.0
// Computed as: Σ(criterionScore.scoreNormalized * criterionScore.weight) * 100
model Evaluation {
  id             String           @id @default(cuid())
  organizationId String
  applicationId  String
  configId       String?
  createdById    String?
  status         EvaluationStatus @default(PENDING)

  // Final score 0.0–100.0. Derived from EvaluationCriterionScore rows.
  // EvaluationCriterionScore is source of truth — this field is a computed cache.
  overallScore Float?

  summary            String?
  explanation        String?
  skillGapSummary    String?
  // Stored as Json for interview question metadata. Rows in EvaluationInterviewQuestion
  // are the source of truth — this field is kept null unless used for snapshot/export.
  interviewQuestions Json?
  evidenceMap        Json?

  // AI model tracking — used for reproducibility and debugging.
  modelProvider   String?
  modelName       String?
  modelVersion    String?
  promptVersion   String?
  evaluationError String?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization          Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  application           Application                   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  config                EvaluationConfig?             @relation(fields: [configId], references: [id], onDelete: SetNull)
  createdBy             User?                         @relation("EvaluationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  criterionScores       EvaluationCriterionScore[]
  skills                EvaluationSkill[]
  interviewQuestionRows EvaluationInterviewQuestion[]

  @@index([organizationId])
  @@index([applicationId])
  @@index([configId])
  @@index([createdById])
  @@index([status])
}

// Per-criterion score for one evaluation.
// scoreNormalized: 0.0–1.0 (raw match quality before weighting)
// weight: must match the corresponding entry in EvaluationConfig.criteriaDefinition
// Contribution to overallScore = scoreNormalized * weight * 100
model EvaluationCriterionScore {
  id              String        @id @default(cuid())
  evaluationId    String
  criterion       CriterionName
  weight          Float
  // 0.0 = no match, 1.0 = perfect match
  scoreNormalized Float
  reason          String?
  // Array of evidence snippets extracted from CV/JD supporting this score.
  evidence        Json?
  createdAt       DateTime      @default(now())

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, criterion])
  @@index([evaluationId])
}

// Skills identified during evaluation — both matched and missing.
model EvaluationSkill {
  id                  String         @id @default(cuid())
  evaluationId        String
  skillName           String
  normalizedSkillName String?
  type                SkillMatchType
  // "HIGH" | "MEDIUM" | "LOW" — reflects how critical this skill is per the JD.
  importance          String?
  // Evidence of where this skill was found (or not found) in the CV.
  evidence            Json?
  note                String?
  createdAt           DateTime       @default(now())

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
  @@index([skillName])
  @@index([normalizedSkillName])
}

// Interview questions generated for one evaluation.
// Source of truth — do not rely on Evaluation.interviewQuestions Json.
model EvaluationInterviewQuestion {
  id           String   @id @default(cuid())
  evaluationId String
  question     String
  category     String?
  linkedSkill  String?
  difficulty   String?
  rationale    String?
  displayOrder Int?
  createdAt    DateTime @default(now())

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
  @@index([linkedSkill])
}

// ─────────────────────────────────────────────
// SCORING BATCH (CV × JD matrix scoring)
// ─────────────────────────────────────────────

// One batch = "score N resumes against M job descriptions". Deliberately
// separate from Candidate/Resume/Application/Evaluation — forcing every
// exploratory batch item into the full CRM pipeline would pollute it with
// data the recruiter hasn't decided to act on yet. See PLAN.md Phase 1.2
// for full rationale. Only exists for enterprise (persisted) batches — the
// public/anonymous tier uses an equivalent ephemeral Redis representation
// instead (Phase 4), never a row here.
model ScoringBatch {
  id                 String             @id @default(cuid())
  organizationId     String
  createdById        String
  name               String?
  status             ScoringBatchStatus @default(PENDING)
  evaluationConfigId String?
  totalCvCount       Int                @default(0)
  totalJdCount       Int                @default(0)
  totalPairCount     Int                @default(0)
  completedPairCount Int                @default(0)
  failedPairCount    Int                @default(0)
  notifyWebhookUrl   String?
  notifyEmail        String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization     Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        User                         @relation("ScoringBatchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  evaluationConfig EvaluationConfig?            @relation(fields: [evaluationConfigId], references: [id], onDelete: SetNull)
  resumeItems      ScoringBatchResume[]
  jdItems          ScoringBatchJobDescription[]
  results          ScoringBatchResult[]

  @@index([organizationId])
  @@index([status])
}

// One CV within a batch. candidateId is only set once this item has been
// "promoted" into the durable Candidate/Resume pipeline (Phase 5) — until
// then it lives entirely inside this row (rawText/parsedData).
// fileAssetId is nullable — a CV submitted as pasted/typed text (AI service
// /parse/resume raw_text path) has no backing file at all.
model ScoringBatchResume {
  id             String      @id @default(cuid())
  batchId        String
  fileAssetId    String?
  checksum       String?
  candidateLabel String?
  status         ParseStatus @default(PENDING)
  rawText        String?
  parsedData     Json?
  parsingError   String?
  candidateId    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  batch     ScoringBatch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  fileAsset FileAsset?           @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)
  candidate Candidate?           @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  results   ScoringBatchResult[]

  @@unique([batchId, fileAssetId])
  @@index([batchId])
  @@index([status])
  @@index([checksum])
}

// One JD within a batch. jobDescriptionId is only set once "promoted"
// (Phase 5) — until then rawText/parsedData live entirely on this row.
// Exactly one of fileAssetId or rawText is expected to be set at creation
// time: a file-based JD (AI service /parse/job-description signed_url path)
// has no rawText until parsing completes; a text-pasted JD has no file.
model ScoringBatchJobDescription {
  id               String      @id @default(cuid())
  batchId          String
  label            String?
  fileAssetId      String?
  rawText          String?
  status           ParseStatus @default(PENDING)
  parsedData       Json?
  parsingError     String?
  jobDescriptionId String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  batch          ScoringBatch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  fileAsset      FileAsset?           @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)
  jobDescription JobDescription?      @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull)
  results        ScoringBatchResult[]

  @@index([batchId])
  @@index([status])
}

// One scored cell in the CV × JD matrix. Mirrors the shape of
// Evaluation/EvaluationCriterionScore/EvaluationSkill/EvaluationInterviewQuestion
// but flattened into JSON columns instead of normalized child tables, since
// batch cells are read as a whole (never queried by individual criterion/skill)
// and this avoids N×M×(criteria+skills+questions) row explosion.
model ScoringBatchResult {
  id                 String           @id @default(cuid())
  batchId            String
  resumeItemId       String
  jdItemId           String
  status             EvaluationStatus @default(PENDING)
  overallScore       Float?
  summary            String?
  criteria           Json?
  skills             Json?
  explanation        String?
  skillGapSummary    String?
  interviewQuestions Json?
  evidenceMap        Json?
  error              String?
  scoredAt           DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  batch      ScoringBatch               @relation(fields: [batchId], references: [id], onDelete: Cascade)
  resumeItem ScoringBatchResume         @relation(fields: [resumeItemId], references: [id], onDelete: Cascade)
  jdItem     ScoringBatchJobDescription @relation(fields: [jdItemId], references: [id], onDelete: Cascade)

  @@unique([resumeItemId, jdItemId])
  @@index([batchId])
  @@index([overallScore])
}

// ─────────────────────────────────────────────
// INTERVIEW QUESTION ONTOLOGY (Phase 7 foundation)
// ─────────────────────────────────────────────

// Reusable question bank for vector-retrieval-backed interview question
// generation, replacing the current pure template output of
// build_interview_questions() (AI service). Separate from
// EvaluationInterviewQuestion (which stores the questions actually shown
// for one Evaluation) — this table is the shared knowledge base retrieval
// draws from. See PLAN.md Phase 7 for the full design rationale (why
// occupation_family/enablers/business_context instead of the IT-biased
// domain/tech_stack/project_archetype first draft).
enum OccupationFamily {
  IT
  MARKETING
  DESIGN
  DATA
  PRODUCT
  SALES
  LEGAL
}

enum CompetencyType {
  HARD_SKILL
  TOOL_SKILL
  KNOWLEDGE_AREA
  SOFT_SKILL
  METHODOLOGY
  COMPLIANCE
}

enum AssessmentTarget {
  RECALL
  APPLICATION
  ANALYSIS
  DECISION_MAKING
  COMMUNICATION
  LEADERSHIP
  OWNERSHIP
}

enum ExperienceBucket {
  ZERO_TO_ONE
  TWO_TO_FOUR
  FIVE_TO_EIGHT
  EIGHT_PLUS
}

enum AutonomyLevel {
  WORKS_INDEPENDENTLY
  LEADS_PROJECTS
  DEFINES_STRATEGY
  MANAGES_PEOPLE
}

enum InterviewQuestionType {
  EXPERIENCE_VALIDATION
  ARTIFACT_DISCUSSION
  DECISION_MAKING
  BEHAVIORAL_EVIDENCE
  REFLECTION
}

enum InterviewQuestionSource {
  SEED
  AI_GENERATED
}

enum QuestionQualityGateStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model InterviewQuestionEntry {
  id               String @id @default(cuid())
  questionText     String

  occupationFamily OccupationFamily
  specialization   String
  enablers         String[]
  businessContext  String

  competency       String
  competencyType   CompetencyType

  assessmentTarget AssessmentTarget

  experienceBucket ExperienceBucket
  autonomyLevel    AutonomyLevel

  questionType     InterviewQuestionType

  rubric           String[]

  // pgvector column — Prisma has no native vector type, so raw SQL
  // ($queryRaw/$executeRaw) is required for embedding writes and
  // similarity search until retrieval is implemented (next branch).
  // Dimension 768 matches Gemini text-embedding-004 — chosen because
  // GEMINI_API_KEY is already configured (unused) in both repos, avoiding
  // a new embedding provider/credential.
  embedding Unsupported("vector(768)")?

  source            InterviewQuestionSource   @default(SEED)
  qualityGateStatus QuestionQualityGateStatus @default(PENDING_REVIEW)
  usageCount        Int                       @default(0)
  lastUsedAt        DateTime?

  // Traceability back to the batch/items that triggered an AI-fallback
  // generation — null for seed data. No FK: this table must outlive any
  // single batch (public batches are ephemeral/Redis-only, see Phase 4).
  originBatchId      String?
  originResumeItemId String?
  originJdItemId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([occupationFamily, specialization])
  @@index([questionType])
  @@index([qualityGateStatus])
}
