NODE_ENV=development
PORT=3000
DATABASE_URL=
DIRECT_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
MAX_FILE_SIZE_MB=5
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=cv-files
REDIS_URL=
AI_SERVICE_URL=
AI_REQUEST_TIMEOUT_MS=30000
USE_MOCK_AI=true

JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=86400

# SMTP is optional in development — EmailService logs and no-ops when unset.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
FRONTEND_URL=http://localhost:3001
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600

# Queue worker concurrency (Phase 2). AI_SCORE_CONCURRENCY is deliberately low —
# see PLAN.md Phase 2 for why raising it does not help (the CrossEncoder blend
# on the AI service side is the real bottleneck, not backend concurrency).
AI_PARSE_RESUME_CONCURRENCY=8
AI_PARSE_JD_CONCURRENCY=8
AI_SCORE_CONCURRENCY=4

# Batch size limits (Phase 3, enterprise tier)
ENTERPRISE_MAX_FILES_PER_BATCH=2000
ENTERPRISE_MAX_JDS_PER_BATCH=50

# Phase 4 — public (anonymous, ephemeral) batches. SUPABASE_PUBLIC_TEMP_BUCKET
# must be created manually in the Supabase dashboard (separate from
# SUPABASE_BUCKET so a bucket-level lifecycle rule can be an independent safety net).
PUBLIC_MAX_FILES_PER_BATCH=2
PUBLIC_MAX_JDS_PER_BATCH=10
PUBLIC_BATCH_TTL_SECONDS=21600
PUBLIC_RATE_LIMIT_MAX_BATCHES_PER_HOUR=5
SUPABASE_PUBLIC_TEMP_BUCKET=file-public

# Phase 7 — LLM provider key pools for interview question generation.
# Each provider supports up to 4 keys (rotated on failure and used to
# continue a response that got cut off mid-generation). All optional —
# a provider with zero keys set is simply skipped.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

GPT_API_KEY_1=
GPT_API_KEY_2=
GPT_API_KEY_3=
GPT_API_KEY_4=
GPT_MODEL=gpt-4o-mini

GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_MODEL=llama-3.3-70b-versatile

CEREBRAS_API_KEY_1=
CEREBRAS_API_KEY_2=
CEREBRAS_API_KEY_3=
CEREBRAS_API_KEY_4=
CEREBRAS_MODEL=gpt-oss-120b